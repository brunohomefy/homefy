rules_version = '2';

// Regras do Firestore do Homefy (fase de testes).
// Publicar com:  firebase deploy --only firestore:rules
// ou colando este conteúdo em Firebase Console → Firestore → Regras → Publicar.

service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo de serviços: qualquer pessoa logada lê.
    // Criação/edição só pelo console do Firebase, por enquanto.
    match /servicos/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Perfil do usuário. Documentos novos usam o Auth UID como ID
    // (dossiê, item 42) e repetem o UID no campo auth_uid.
    match /usuarios/{uid} {
      // Fase de testes: quem está logado pode ler perfis, para a Home
      // mostrar o nome do profissional de cada serviço.
      // ATENÇÃO: isso inclui e-mail e telefone. Antes do lançamento,
      // separar os dados públicos dos privados.
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['nome', 'email', 'auth_uid', 'cidade', 'eh_profissional', 'criado_em'])
        && request.resource.data.auth_uid == uid
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 3
        && request.resource.data.eh_profissional == false;

      // A pessoa só pode trocar o próprio nome por aqui. Virar profissional,
      // nota, destaque etc. vão ganhar fluxo próprio depois.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome']);

      allow delete: if false;
    }

    // Todo o resto fica fechado até ser desenhado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
