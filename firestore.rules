rules_version = '2';

// Regras do Firestore do Homefy (fase de testes, piloto em Caruaru).
// Publicar colando este conteúdo em Firebase Console → Firestore → Regras → Publicar
// (ou: firebase deploy --only firestore:rules).
// Testadas automaticamente no GitHub Actions (pasta tests_regras/).
//
// Princípio (LGPD): só fica legível para outros usuários o que precisa ser
// público. E-mail e WhatsApp nunca ficam no perfil público.

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function eDono(uid) {
      return logado() && request.auth.uid == uid;
    }

    function caminhoUsuario(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function textoAte(v, max) {
      return v is string && v.size() <= max;
    }

    function listaAte(v, max) {
      return v is list && v.size() <= max;
    }

    // ───────────── Perfil público ─────────────
    // Documentos novos usam o Auth UID como ID (dossiê, item 42).
    match /usuarios/{uid} {
      // Quem está logado lê perfis: nome, descrição, categorias e bairros
      // do profissional aparecem para o cliente.
      allow read: if logado();

      allow create: if eDono(uid)
        && request.resource.data.keys().hasOnly(
             ['nome', 'auth_uid', 'cidade', 'eh_profissional', 'criado_em'])
        && request.resource.data.auth_uid == uid
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 3
        && request.resource.data.nome.size() <= 80
        && request.resource.data.eh_profissional == false;

      // A pessoa altera só o próprio perfil e só estes campos.
      // Apagar o campo 'email' antigo também é permitido (limpeza LGPD).
      allow update: if eDono(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'nome', 'email', 'eh_profissional', 'categorias', 'subtipos',
             'bairros', 'atende_toda_cidade', 'descricao',
             'profissional_desde', 'atualizado_em'])
        && !('email' in request.resource.data)
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 3
        && request.resource.data.nome.size() <= 80
        && request.resource.data.get('eh_profissional', false) is bool
        && (request.resource.data.get('eh_profissional', false) == false
            || perfilProfissionalValido(uid));

      allow delete: if false;

      // Profissional precisa de categoria, área de atendimento e WhatsApp.
      // existsAfter/getAfter: o WhatsApp é gravado no mesmo lote (batch).
      function perfilProfissionalValido(uid) {
        let d = request.resource.data;
        let contato = /databases/$(database)/documents/usuarios/$(uid)/privado/contato;
        return listaAte(d.get('categorias', null), 4) && d.categorias.size() >= 1
          && listaAte(d.get('subtipos', []), 30)
          && listaAte(d.get('bairros', []), 60)
          && d.get('atende_toda_cidade', false) is bool
          && (d.get('atende_toda_cidade', false) == true || d.get('bairros', []).size() >= 1)
          && textoAte(d.get('descricao', ''), 500)
          && existsAfter(contato)
          && getAfter(contato).data.get('whatsapp', '').matches('55[0-9]{10,11}');
      }

      // ───────────── Dados privados ─────────────
      // O dono lê e grava. Um cliente com atendimento CONFIRMADO com este
      // profissional também lê (decisão D3), via usuarios/{uid}/liberados/{cliente}.
      match /privado/contato {
        allow read: if eDono(uid)
          || (logado() && exists(/databases/$(database)/documents/usuarios/$(uid)/liberados/$(request.auth.uid)));
        allow create, update: if eDono(uid)
          && request.resource.data.keys().hasOnly(['whatsapp', 'atualizado_em'])
          && request.resource.data.whatsapp is string
          && request.resource.data.whatsapp.matches('55[0-9]{10,11}');
        allow delete: if false;
      }

      // Quem pode ver o WhatsApp deste profissional. Criado pelo cliente no
      // mesmo lote em que confirma o atendimento; removido se cancelar.
      match /liberados/{clienteUid} {
        allow read: if eDono(uid) || eDono(clienteUid);
        allow create: if eDono(clienteUid)
          && request.resource.data.keys().hasOnly(['solicitacao_id'])
          && solicitacaoDepois(request.resource.data.solicitacao_id).status == 'confirmada'
          && solicitacaoDepois(request.resource.data.solicitacao_id).cliente_uid == clienteUid
          && solicitacaoDepois(request.resource.data.solicitacao_id).profissional_uid == uid;
        allow delete: if logado()
          && (request.auth.uid == clienteUid || request.auth.uid == uid)
          && solicitacaoDepois(resource.data.solicitacao_id).status == 'cancelada';
        allow update: if false;
      }
    }

    function solicitacaoDepois(id) {
      return getAfter(/databases/$(database)/documents/solicitacoes/$(id)).data;
    }

    // ───────────── Solicitações de atendimento ─────────────
    // Fluxo: pendente → (profissional) proposta | recusada
    //        proposta → (cliente) confirmada | cancelada
    //        pendente → (cliente) cancelada
    //        confirmada → (qualquer um) cancelada | (profissional) concluida
    // Só cliente e profissional da solicitação leem. Endereço completo NÃO
    // fica no banco: é combinado pelo WhatsApp depois da confirmação (LGPD).
    match /solicitacoes/{id} {
      function eParte() {
        return logado() && (request.auth.uid == resource.data.cliente_uid
          || request.auth.uid == resource.data.profissional_uid);
      }
      function mudou() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function de(st) { return resource.data.status == st; }
      function para(st) { return request.resource.data.status == st; }
      function eCliente() { return logado() && request.auth.uid == resource.data.cliente_uid; }
      function eProfissional() { return logado() && request.auth.uid == resource.data.profissional_uid; }
      function agendaId() {
        return resource.data.profissional_uid + '_' + resource.data.data + '_' + resource.data.periodo;
      }

      allow read: if eParte();

      allow create: if logado()
        && request.resource.data.keys().hasOnly([
             'cliente_uid', 'cliente_nome', 'profissional_uid', 'profissional_nome', 'servico_id',
             'servico_nome', 'categoria_id', 'variacao', 'preco_referencia',
             'data', 'periodo', 'bairro', 'observacao', 'status', 'criado_em'])
        && request.resource.data.cliente_uid == request.auth.uid
        && request.resource.data.profissional_uid != request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.criado_em == request.time
        && textoAte(request.resource.data.get('cliente_nome', ''), 80)
        && textoAte(request.resource.data.get('profissional_nome', ''), 80)
        && textoAte(request.resource.data.get('servico_nome', ''), 60)
        && textoAte(request.resource.data.get('categoria_id', ''), 20)
        && textoAte(request.resource.data.get('variacao', ''), 40)
        && (request.resource.data.get('preco_referencia', null) == null
            || request.resource.data.preco_referencia is number)
        && request.resource.data.get('data', '') is string
        && request.resource.data.data.matches('20[0-9]{2}-[01][0-9]-[0-3][0-9]')
        && request.resource.data.get('periodo', '') in ['manha', 'tarde', 'noite']
        && textoAte(request.resource.data.get('bairro', ''), 60)
        && textoAte(request.resource.data.get('observacao', ''), 500)
        // O serviço existe, está ativo e é mesmo deste profissional.
        && get(/databases/$(database)/documents/servicos/$(request.resource.data.servico_id)).data.ativo == true
        && get(/databases/$(database)/documents/servicos/$(request.resource.data.servico_id)).data.profissional_ref
             == caminhoUsuario(request.resource.data.profissional_uid);

      allow update: if eParte() && (
        // Profissional envia o valor final.
        (eProfissional() && de('pendente') && para('proposta')
          && mudou().hasOnly(['status', 'valor_final', 'mensagem_profissional', 'respondido_em'])
          && request.resource.data.valor_final is number
          && request.resource.data.valor_final > 0
          && request.resource.data.valor_final <= 100000
          && textoAte(request.resource.data.get('mensagem_profissional', ''), 500)
          && request.resource.data.respondido_em == request.time)
        // Profissional recusa.
        || (eProfissional() && de('pendente') && para('recusada')
          && mudou().hasOnly(['status', 'mensagem_profissional', 'respondido_em'])
          && textoAte(request.resource.data.get('mensagem_profissional', ''), 500)
          && request.resource.data.respondido_em == request.time)
        // Cliente confirma: no mesmo lote cria a trava de agenda e a liberação do WhatsApp.
        || (eCliente() && de('proposta') && para('confirmada')
          && mudou().hasOnly(['status', 'confirmado_em'])
          && request.resource.data.confirmado_em == request.time
          && existsAfter(/databases/$(database)/documents/agenda/$(agendaId()))
          && getAfter(/databases/$(database)/documents/agenda/$(agendaId())).data.solicitacao_id == id)
        // Cliente desiste antes de confirmar.
        || (eCliente() && (de('pendente') || de('proposta')) && para('cancelada')
          && mudou().hasOnly(['status', 'cancelado_por', 'cancelado_em'])
          && request.resource.data.cancelado_por == 'cliente'
          && request.resource.data.cancelado_em == request.time)
        // Qualquer um cancela um atendimento confirmado, liberando o horário no mesmo lote.
        || (de('confirmada') && para('cancelada')
          && mudou().hasOnly(['status', 'cancelado_por', 'cancelado_em'])
          && request.resource.data.cancelado_por == (eCliente() ? 'cliente' : 'profissional')
          && request.resource.data.cancelado_em == request.time
          && !existsAfter(/databases/$(database)/documents/agenda/$(agendaId())))
        // Profissional marca como concluído.
        || (eProfissional() && de('confirmada') && para('concluida')
          && mudou().hasOnly(['status', 'concluido_em'])
          && request.resource.data.concluido_em == request.time)
      );

      allow delete: if false;

      // WhatsApp do cliente: o profissional só lê depois da confirmação.
      match /privado/cliente {
        function pai() {
          return get(/databases/$(database)/documents/solicitacoes/$(id)).data;
        }
        allow read: if logado() && (request.auth.uid == pai().cliente_uid
          || (request.auth.uid == pai().profissional_uid && pai().status in ['confirmada', 'concluida']));
        allow create: if logado()
          && getAfter(/databases/$(database)/documents/solicitacoes/$(id)).data.cliente_uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['whatsapp'])
          && request.resource.data.whatsapp is string
          && request.resource.data.whatsapp.matches('55[0-9]{10,11}');
        allow update, delete: if false;
      }
    }

    // ───────────── Avaliações ─────────────
    // Uma por atendimento: o ID é o mesmo da solicitação. Só o cliente avalia,
    // só depois de "concluída", e não pode mudar nem apagar depois (sem edição
    // não há como "comprar" nota trocando o texto). Pública para logados.
    match /avaliacoes/{solicitacaoId} {
      allow read: if logado();
      allow create: if logado()
        && request.resource.data.keys().hasOnly([
             'profissional_uid', 'cliente_uid', 'cliente_nome', 'servico_nome',
             'nota', 'comentario', 'criado_em'])
        && request.resource.data.cliente_uid == request.auth.uid
        && get(/databases/$(database)/documents/solicitacoes/$(solicitacaoId)).data.status == 'concluida'
        && get(/databases/$(database)/documents/solicitacoes/$(solicitacaoId)).data.cliente_uid == request.auth.uid
        && get(/databases/$(database)/documents/solicitacoes/$(solicitacaoId)).data.profissional_uid
             == request.resource.data.profissional_uid
        && request.resource.data.get('nota', 0) is int
        && request.resource.data.nota >= 1 && request.resource.data.nota <= 5
        && textoAte(request.resource.data.get('comentario', ''), 300)
        && textoAte(request.resource.data.get('cliente_nome', ''), 40)
        && textoAte(request.resource.data.get('servico_nome', ''), 60)
        && request.resource.data.get('criado_em', null) == request.time;
      allow update, delete: if false;
    }

    // ───────────── Agenda (trava de horário) ─────────────
    // ID = {profissional}_{AAAA-MM-DD}_{periodo}. Como dois documentos não podem
    // ter o mesmo ID, o mesmo horário nunca é confirmado duas vezes.
    // Qualquer logado lê só para saber se o horário está livre (não há dado pessoal).
    match /agenda/{slot} {
      allow read: if logado();
      allow create: if logado()
        && request.resource.data.keys().hasOnly(['solicitacao_id', 'profissional_uid'])
        && solicitacaoDepois(request.resource.data.solicitacao_id).status == 'confirmada'
        && solicitacaoDepois(request.resource.data.solicitacao_id).cliente_uid == request.auth.uid
        && request.resource.data.profissional_uid == solicitacaoDepois(request.resource.data.solicitacao_id).profissional_uid
        && slot == solicitacaoDepois(request.resource.data.solicitacao_id).profissional_uid + '_'
             + solicitacaoDepois(request.resource.data.solicitacao_id).data + '_'
             + solicitacaoDepois(request.resource.data.solicitacao_id).periodo;
      allow delete: if logado()
        && solicitacaoDepois(resource.data.solicitacao_id).status == 'cancelada'
        && (request.auth.uid == solicitacaoDepois(resource.data.solicitacao_id).cliente_uid
            || request.auth.uid == solicitacaoDepois(resource.data.solicitacao_id).profissional_uid);
      allow update: if false;
    }

    // ───────────── Catálogo de serviços ─────────────
    match /servicos/{id} {
      allow read: if logado();

      // Só profissional cria, e sempre em nome de si mesmo.
      allow create: if logado()
        && request.resource.data.get('profissional_ref', null) == caminhoUsuario(request.auth.uid)
        && get(caminhoUsuario(request.auth.uid)).data.get('eh_profissional', false) == true
        && servicoValido(request.resource.data);

      // Só o dono edita, e não pode passar o serviço para outra pessoa.
      allow update: if logado()
        && resource.data.get('profissional_ref', null) == caminhoUsuario(request.auth.uid)
        && request.resource.data.get('profissional_ref', null) == resource.data.profissional_ref
        && servicoValido(request.resource.data);

      // Não se apaga: desativa (ativo = false). Preserva o histórico.
      allow delete: if false;

      function servicoValido(d) {
        let preco = d.get('preco_base', null);
        let duracao = d.get('duracao_minutos', null);
        let subtipo = d.get('subtipo', null);
        return d.keys().hasOnly([
                 'nome_servico', 'categoria', 'categoria_id', 'subtipo', 'descricao',
                 'variacoes', 'preco_base', 'duracao_minutos', 'bairros',
                 'atende_toda_cidade', 'ativo', 'profissional_ref',
                 'criado_em', 'atualizado_em'])
          && d.get('nome_servico', '') is string
          && d.nome_servico.size() >= 3 && d.nome_servico.size() <= 60
          && d.get('categoria_id', '') in ['cabelo', 'manicure', 'veiculos', 'limpeza']
          && textoAte(d.get('categoria', ''), 40)
          && (subtipo == null || textoAte(subtipo, 40))
          && textoAte(d.get('descricao', ''), 500)
          && listaAte(d.get('variacoes', null), 6) && d.variacoes.size() >= 1
          && (preco == null || (preco is number && preco >= 0 && preco <= 100000))
          && (duracao == null || (duracao is int && duracao > 0 && duracao <= 1440))
          && listaAte(d.get('bairros', []), 60)
          && d.get('atende_toda_cidade', false) is bool
          && d.get('ativo', null) is bool;
      }
    }

    // ───────────── Feedbacks ─────────────
    // "Não achou o que precisa?" e "Conte sua experiência".
    // Qualquer pessoa logada envia; ninguém lê pelo app (o Bruno lê no console).
    match /feedbacks/{id} {
      allow create: if logado()
        && request.resource.data.keys().hasOnly(
             ['autor_uid', 'tipo', 'texto', 'categoria_id', 'busca', 'bairro', 'criado_em'])
        && request.resource.data.get('autor_uid', '') == request.auth.uid
        && request.resource.data.get('tipo', '') in ['nao_achei', 'experiencia']
        && request.resource.data.get('texto', null) is string
        && request.resource.data.texto.size() >= 3
        && request.resource.data.texto.size() <= 1000
        && textoAte(request.resource.data.get('categoria_id', ''), 20)
        && textoAte(request.resource.data.get('busca', ''), 100)
        && textoAte(request.resource.data.get('bairro', ''), 60)
        && request.resource.data.get('criado_em', null) == request.time;
      allow read, update, delete: if false;
    }

    // Todo o resto fica fechado até ser desenhado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
